# Perfetto config for a 15 s capture of the app on the phone: scheduling, CPU frequencies,
# HWUI/Compose atrace sections, the SurfaceFlinger frame timeline, GPU memory and Compose
# composition tracing (track_event). scripts/trace-phone.sh rewrites atrace_apps to APP_PACKAGE.
# Ported from dash:scripts/dash-trace.pbtxt.
buffers { size_kb: 131072 fill_policy: RING_BUFFER }
buffers { size_kb: 8192   fill_policy: RING_BUFFER }

data_sources { config { name: "linux.ftrace" ftrace_config {
  ftrace_events: "sched/sched_switch"
  ftrace_events: "sched/sched_waking"
  ftrace_events: "sched/sched_wakeup_new"
  ftrace_events: "power/cpu_frequency"
  ftrace_events: "power/cpu_idle"
  ftrace_events: "ftrace/print"
  atrace_categories: "gfx"
  atrace_categories: "view"
  atrace_categories: "input"
  atrace_categories: "sched"
  atrace_categories: "freq"
  atrace_categories: "idle"
  atrace_categories: "binder_driver"
  atrace_categories: "ss"
  atrace_categories: "dalvik"
  atrace_apps: "com.example.starter"
} } }
data_sources { config { name: "linux.process_stats" process_stats_config { scan_all_processes_on_start: true } } }
data_sources { config { name: "android.surfaceflinger.frametimeline" } }
data_sources { config { name: "android.gpu.memory" } }
data_sources { config { name: "track_event" target_buffer: 1 } }

duration_ms: 15000
flush_period_ms: 5000
incremental_state_config { clear_period_ms: 5000 }
